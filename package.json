{
  "name": "breach-command",
  "version": "0.9.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "test": "node --test \"tests/*.test.ts\"",
    "balance": "node scripts/balance.ts",
    "test:a11y": "playwright test tests/e2e/accessibility.spec.ts",
    "test:e2e": "playwright test",
    "test:persistence": "playwright test tests/e2e/persistence.spec.ts",
    "test:visual": "playwright test tests/e2e/visual.spec.ts",
    "test:performance": "playwright test tests/e2e/performance.spec.ts",
    "test:browsers": "PLAYWRIGHT_ALL_BROWSERS=1 playwright test",
    "test:responsive": "playwright test tests/e2e/responsive-game.spec.ts",
    "test:responsive:headed": "playwright test tests/e2e/responsive-game.spec.ts --headed",
    "test:responsive:install": "playwright install chromium",
    "start": "next start",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern .vinext",
    "repetition": "node scripts/repetition.ts",
    "validate:content": "node --test tests/content.test.ts tests/glossary.test.ts tests/drafts.test.ts",
    "balance:check": "node scripts/balance-check.ts",
    "new-scenario": "node scripts/new-scenario.ts"
  },
  "dependencies": {
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "^1.31.0",
    "next": "16.3.4",
    "radix-ui": "^1.6.7",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "axe-core": "4.10.2",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "4.2.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3"
  },
  "type": "module",
  "packageManager": "pnpm@11.25.0"
}
